+static void gemslot_pump_init(struct gemslot_dev *gs)
+{
+	struct device_node *np;
+	struct resource res;
+	int err;
+
+	np = of_find_compatible_node(NULL, NULL, "plutosky,stream-csr");
+	if (!np)
+		return;
+	err = of_address_to_resource(np, 0, &res);
+	if (!err)
+		gs->csr = of_iomap(np, 0);
+	of_node_put(np);
+	if (err || !gs->csr)
+		return;
+	gs->csr_phys = res.start;
+	gs->csr_size = resource_size(&res);
+	if (gs->csr_phys > U32_MAX || gs->csr_size < sizeof(u32))
+		goto unmap;
+
+	gs->pump_task = kthread_run(gemslot_pump_thread, gs, "gemslot-pump");
+	if (IS_ERR(gs->pump_task)) {
+		gs->pump_task = NULL;
+		goto unmap;
+	}
+	np = of_find_compatible_node(NULL, NULL, "plutosky,stream-irq");
+	if (!np)
+		return;
+	gs->pump_irq = irq_of_parse_and_map(np, 0);
+	of_node_put(np);
+	if (gs->pump_irq <= 0) {
+		gs->pump_irq = -1;
+		return;
+	}
+	err = request_irq(gs->pump_irq, gemslot_pump_interrupt, 0,
+			  "gemslot-pump", gs);
+	if (!err)
+		return;
+	irq_dispose_mapping(gs->pump_irq);
+	gs->pump_irq = -1;
+	return;
+unmap:
+	iounmap(gs->csr);
+	gs->csr = NULL;
+}
+
+int macb_gemslot_probe(struct macb *bp)
+{
+	struct device *dev = &bp->pdev->dev;
+	struct device_node *np;
+	struct gemslot_dev *gs;
+	struct resource res;
+	size_t need;
+	int err;
+
+	np = of_parse_phandle(dev->of_node, "memory-region", 0);
+	if (!np)
+		return 0;
+
+	err = of_address_to_resource(np, 0, &res);
+	of_node_put(np);
+	if (err) {
+		dev_err(dev, "gemslot: memory-region has no address\n");
+		return err;
+	}
+
+	/* Slot indices are 16 bits and GEMSLOT_NO_SLOT takes the top value. */
+	if (!gemslot_slots || gemslot_slots >= GEMSLOT_NO_SLOT) {
+		dev_err(dev, "gemslot: slots must be between 1 and %u\n",
+			GEMSLOT_NO_SLOT - 1);
+		return -EINVAL;
+	}
+
+	gs = devm_kzalloc(dev, sizeof(*gs), GFP_KERNEL);
+	if (!gs)
+		return -ENOMEM;
+
+	gs->bp = bp;
+	gs->ddrc_mode_sts = devm_ioremap(dev, GEMSLOT_DDRC_MODE_STS_PHYS,
+					 sizeof(u32));
+	if (!gs->ddrc_mode_sts)
+		return -ENOMEM;
+	gs->pool_phys = res.start;
+	gs->pool_size = resource_size(&res);
+	gs->slot_size = GEMSLOT_SLOT_SIZE;
+	gs->slot_count = gemslot_slots;
+	gs->tx_offset = 0;
+	gs->rx_offset = gs->slot_count * gs->slot_size;
+
+	need = (size_t)gs->slot_count * gs->slot_size * 2;
+	if (need > gs->pool_size) {
+		dev_err(dev, "gemslot: pool of %zu bytes is short of the %zu two rings need\n",
+			gs->pool_size, need);
+		return -EINVAL;
+	}
+
+	/* The region is no-map, so nothing else holds a cacheable alias and a
+	 * write-combining mapping needs no cache maintenance against the DMA.
+	 */
+	gs->pool = devm_memremap(dev, gs->pool_phys, gs->pool_size, MEMREMAP_WC);
+	if (IS_ERR(gs->pool))
+		return PTR_ERR(gs->pool);
+
+	gs->tx_comp_buf = devm_kcalloc(dev, GEMSLOT_COMP_RING,
+				       sizeof(*gs->tx_comp_buf), GFP_KERNEL);
+	gs->rx_steer_buf = devm_kcalloc(dev, GEMSLOT_STEER_RING,
+					sizeof(*gs->rx_steer_buf), GFP_KERNEL);
+	gs->rx_free_buf = devm_kcalloc(dev, GEMSLOT_FREE_RING,
+				       sizeof(*gs->rx_free_buf), GFP_KERNEL);
+	gs->portmap = devm_kzalloc(dev, GEMSLOT_PORTMAP_BYTES, GFP_KERNEL);
+	gs->rx_outstanding = devm_kzalloc(dev, BITS_TO_BYTES(gs->slot_count),
+					  GFP_KERNEL);
+	if (!gs->tx_comp_buf || !gs->rx_steer_buf || !gs->rx_free_buf ||
+	    !gs->portmap || !gs->rx_outstanding)
+		return -ENOMEM;
+
+	spin_lock_init(&gs->tx_lock);
+	spin_lock_init(&gs->rx_lock);
+	init_waitqueue_head(&gs->wq);
+	init_waitqueue_head(&gs->pump_wq);
+	mutex_init(&gs->pump_lock);
+	atomic_set(&gs->pump_event, 0);
+	atomic_set(&gs->pump_irq_masked, 0);
+	gs->pump_irq = -1;
+	gemslot_ring_init(&gs->tx_comp, GEMSLOT_COMP_RING);
+
+	gs->misc.minor = MISC_DYNAMIC_MINOR;
+	gs->misc.name = "gemslot0";
+	gs->misc.fops = &gemslot_fops;
+	gs->misc.parent = dev;
+
+	bp->gemslot = gs;
+	macb_gemslot_init_pool(bp);
+	gemslot_pump_init(gs);
+
+	err = misc_register(&gs->misc);
+	if (err) {
+		dev_err(dev, "gemslot: cannot register /dev/gemslot0\n");
+		macb_gemslot_remove(bp);
+		return err;
+	}
+	gs->registered = true;
+
+	gs->debugfs = debugfs_create_dir("gemslot0", NULL);
+	debugfs_create_file("stats", 0444, gs->debugfs, gs, &gemslot_stats_fops);
+
+	dev_info(dev, "gemslot: %u slots of %u bytes per ring at %pa, tx +0x%x rx +0x%x\n",
+		 gs->slot_count, gs->slot_size, &gs->pool_phys,
+		 gs->tx_offset, gs->rx_offset);
+
+	return 0;
+}
+
+void macb_gemslot_remove(struct macb *bp)
+{
+	struct gemslot_dev *gs = bp->gemslot;
+
+	if (!gs)
+		return;
+	if (gs->pump_irq > 0) {
+		free_irq(gs->pump_irq, gs);
+		irq_dispose_mapping(gs->pump_irq);
+	}
+	if (gs->pump_task)
+		kthread_stop(gs->pump_task);
+	if (gs->csr)
+		iounmap(gs->csr);
+
+	debugfs_remove_recursive(gs->debugfs);
+	if (gs->registered)
+		misc_deregister(&gs->misc);
+	bp->gemslot = NULL;
+}
diff --git a/drivers/net/ethernet/cadence/macb_gemslot.h b/drivers/net/ethernet/cadence/macb_gemslot.h
new file mode 100644
index 000000000..8a4fb2895
--- /dev/null
+++ b/drivers/net/ethernet/cadence/macb_gemslot.h
@@ -0,0 +1,182 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * GEM slot fast path: a reserved-memory slot pool that the PL fills and drains,
+ * configured from user space through /dev/gemslot0 instead of through the
+ * socket layer. Normal networking keeps running on the same interface.
+ */
+#ifndef _MACB_GEMSLOT_H
+#define _MACB_GEMSLOT_H
+
+#include <linux/atomic.h>
+#include <linux/io.h>
+#include <linux/miscdevice.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/wait.h>
+#include <uapi/linux/gemslot.h>
+
+#include "macb_gemslot_lib.h"
+
+#define GEMSLOT_SLOT_SIZE	9728
+#define GEMSLOT_SLOT_COUNT	2048
+
+/* Marks a receive ring entry that holds no slot. */
+#define GEMSLOT_NO_SLOT		0xffffu
+
+/* Completion and steer rings hold at most one entry per slot. */
+#define GEMSLOT_COMP_RING	4096
+#define GEMSLOT_STEER_RING	4096
+#define GEMSLOT_FREE_RING	4096
+
+/* Largest jumbo MTU the fast path offers, and the frame it implies. */
+#define GEMSLOT_JUMBO_MTU	9000
+#define GEMSLOT_JUMBO_FRAME_LEN	(GEMSLOT_JUMBO_MTU + ETH_HLEN + ETH_FCS_LEN)
+
+/* Receive buffer size the fallback programs when jumbo receive is off. */
+#define GEMSLOT_SMALL_RX_BUF	1536
+
+struct macb;
+struct macb_queue;
+struct task_struct;
+
+struct gemslot_direct_stream {
+	struct file		*owner;
+	struct gemslot_stream_config config;
+	bool			active;
+	bool			stopping;
+	u32			base;
+	u32			last_produced;
+	u32			queued;
+	u32			released;
+	u32			inflight_head;
+	u32			inflight_tail;
+	u16			inflight[GEMSLOT_BATCH_MAX];
+	u64			end_ticks[GEMSLOT_BATCH_MAX];
+	u64			produced;
+	u64			submitted;
+	u64			completed;
+	u64			consumed_ticks;
+	u64			dropped;
+};
+
+struct gemslot_dev {
+	struct macb		*bp;
+	struct miscdevice	misc;
+	struct dentry		*debugfs;
+	bool			registered;
+
+	phys_addr_t		pool_phys;
+	size_t			pool_size;
+	void			*pool;
+
+	u32			slot_size;
+	u32			slot_count;
+	u32			tx_offset;
+	u32			rx_offset;
+
+	/* Completions, filled by the transmit interrupt. */
+	spinlock_t		tx_lock;
+	struct gemslot_ring	tx_comp;
+	struct gemslot_tx_entry	*tx_comp_buf;
+
+	/* Steered frames and free receive slots, both touched from NAPI. */
+	spinlock_t		rx_lock;
+	struct gemslot_ring	rx_steer;
+	struct gemslot_rx_entry	*rx_steer_buf;
+	struct gemslot_ring	rx_free;
+	u16			*rx_free_buf;
+
+	u8			*portmap;
+	/* One bit per receive slot the daemon is holding, so a slot returned
+	 * twice is refused instead of landing in the free list twice.
+	 */
+	u8			*rx_outstanding;
+
+	wait_queue_head_t	wq;
+	struct mutex		pump_lock;
+	wait_queue_head_t	pump_wq;
+	struct task_struct	*pump_task;
+	struct gemslot_direct_stream direct[2];
+	bool			tx_irq_polling;
+	void __iomem		*csr;
+	void __iomem		*ddrc_mode_sts;
+	phys_addr_t		csr_phys;
+	u32			csr_size;
+	int			pump_irq;
+	atomic_t		pump_irq_masked;
+	atomic_t		pump_event;
+
+	u64			tx_frames;
+	u64			rx_steered;
+	u64			rx_copied;
+	u64			rx_starved;
+	u64			rx_oversize;
+	u32			irq_total;
+	u32			irq_rcomp;
+	u32			irq_tcomp;
+	u32			irq_txubr;
+	u32			irq_rxubr;
+	u32			irq_rovr;
+	u32			irq_txerr;
+	u64			rx_poll_calls;
+	u64			rx_poll_budget;
+	u32			rx_poll_max_work;
+	u64			rx_poll_max_ns;
+	u64			rx_poll_busy_gap_max_ns;
+	u64			rx_poll_end_ns;
+	bool			rx_poll_was_busy;
+	u32			rx_desc_ready_min;
+	bool			rx_desc_ready_seen;
+	bool			rx_overrun_seen;
+	bool			rx_overrun_from_poll;
+	u32			rx_overrun_isr;
+	u32			rx_overrun_rsr;
+	u32			rx_overrun_desc_ready;
+	u32			rx_overrun_used_count;
+	u32			rx_overrun_dma_ready;
+	u32			rx_overrun_used_prefix;
+	u64			rx_overrun_poll_age_ns;
+	u32			rx_overrun_ddrc_mode_sts;
+};
+
+static inline u32 gemslot_ring_base(const struct gemslot_dev *gs, bool tx)
+{
+	return (u32)gs->pool_phys + (tx ? gs->tx_offset : gs->rx_offset);
+}
+
+static inline u32 gemslot_phys(const struct gemslot_dev *gs, bool tx, u16 slot)
+{
+	return gemslot_ring_base(gs, tx) + (u32)slot * gs->slot_size;
+}
+
+static inline void *gemslot_va(const struct gemslot_dev *gs, bool tx, u16 slot)
+{
+	u32 off = (tx ? gs->tx_offset : gs->rx_offset) + (u32)slot * gs->slot_size;
+
+	return (u8 *)gs->pool + off;
+}
+
+extern bool macb_gemslot_jumbo;
+extern bool macb_gemslot_fast_tx;
+
+int macb_gemslot_probe(struct macb *bp);
+void macb_gemslot_remove(struct macb *bp);
+void macb_gemslot_link_down(struct gemslot_dev *gs);
+void macb_gemslot_fault(struct gemslot_dev *gs);
+
+/* Called from the transmit completion path with bp->lock held. */
+void macb_gemslot_tx_done(struct gemslot_dev *gs, u16 slot, u16 len);
+
+/* Receive slot allocation and return, called from NAPI and from the ioctl. */
+int macb_gemslot_take_slot(struct gemslot_dev *gs);
+void macb_gemslot_put_slot(struct gemslot_dev *gs, u16 slot);
+int macb_gemslot_return_slot(struct gemslot_dev *gs, u16 slot);
+void macb_gemslot_deliver(struct gemslot_dev *gs, u16 slot, u16 len);
+void macb_gemslot_wake(struct gemslot_dev *gs);
+
+/* Implemented in macb_main.c, where the descriptor helpers live. */
+int macb_gemslot_submit(struct macb *bp, const struct gemslot_tx_entry *entries,
+			u32 count);
+void macb_gemslot_poll_tx(struct macb *bp, bool direct_rx_active);
+
+#endif /* _MACB_GEMSLOT_H */
diff --git a/drivers/net/ethernet/cadence/macb_gemslot_lib.h b/drivers/net/ethernet/cadence/macb_gemslot_lib.h
new file mode 100644
index 000000000..5adeed31e
--- /dev/null
+++ b/drivers/net/ethernet/cadence/macb_gemslot_lib.h
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Frame classification and slot-ring bookkeeping for the GEM slot fast path.
+ *
+ * Everything here is free of kernel dependencies so the same code that runs in
+ * the receive path can be compiled and tested on the host.
+ */
+#ifndef _MACB_GEMSLOT_LIB_H
+#define _MACB_GEMSLOT_LIB_H
+
+#include <linux/types.h>
+
+/* One bit per UDP destination port. */
+#define GEMSLOT_PORTMAP_BYTES	(65536 / 8)
+
+#define GEMSLOT_ETH_HLEN	14
+#define GEMSLOT_ETHERTYPE_OFF	12
+#define GEMSLOT_ETHERTYPE_IPV4	0x0800
+#define GEMSLOT_ETHERTYPE_VLAN	0x8100
+#define GEMSLOT_VLAN_TAG_LEN	4
+#define GEMSLOT_IPV4_MIN_IHL	5
+#define GEMSLOT_IPPROTO_UDP	17
+#define GEMSLOT_IPV4_FRAG_MASK	0x3fff
+#define GEMSLOT_UDP_HLEN	8
+
+static inline __u16 gemslot_be16(const __u8 *p)
+{
+	return (__u16)(((__u16)p[0] << 8) | p[1]);
+}
+
+static inline int gemslot_bit_test(const __u8 *map, unsigned int n)
+{
+	return (map[n >> 3] >> (n & 7)) & 1;
+}
+
+static inline void gemslot_bit_assign(__u8 *map, unsigned int n, int on)
+{
+	__u8 bit = (__u8)(1u << (n & 7));
+	__u8 v = map[n >> 3];
+
+	map[n >> 3] = on ? (__u8)(v | bit) : (__u8)(v & ~bit);
+}
+
+/*
+ * The UDP destination port of an IPv4 frame, or -1 when the frame is anything
+ * else. Only the first fragment carries a UDP header, so a later fragment is
+ * left for the stack.
+ */
+static inline int gemslot_udp_dport(const __u8 *frame, unsigned int len)
+{
+	unsigned int off = GEMSLOT_ETH_HLEN;
+	unsigned int ihl, udp;
+	__u16 type;
+
+	if (len < GEMSLOT_ETH_HLEN)
+		return -1;
+
+	type = gemslot_be16(frame + GEMSLOT_ETHERTYPE_OFF);
+	if (type == GEMSLOT_ETHERTYPE_VLAN) {
+		if (len < off + GEMSLOT_VLAN_TAG_LEN)
+			return -1;
+		type = gemslot_be16(frame + off + 2);
+		off += GEMSLOT_VLAN_TAG_LEN;
+	}
+	if (type != GEMSLOT_ETHERTYPE_IPV4)
+		return -1;
+
+	if (len < off + 20)
+		return -1;
+	if ((frame[off] >> 4) != 4)
+		return -1;
+
+	ihl = frame[off] & 0x0f;
+	if (ihl < GEMSLOT_IPV4_MIN_IHL)
+		return -1;
+	if (frame[off + 9] != GEMSLOT_IPPROTO_UDP)
+		return -1;
+	if (gemslot_be16(frame + off + 6) & GEMSLOT_IPV4_FRAG_MASK)
+		return -1;
+
+	udp = off + ihl * 4;
+	if (len < udp + GEMSLOT_UDP_HLEN)
+		return -1;
+
+	return gemslot_be16(frame + udp + 2);
+}
+
+static inline int gemslot_steered(const __u8 *map, const __u8 *frame,
+				  unsigned int len)
+{
+	int port = gemslot_udp_dport(frame, len);
+
+	return port >= 0 && gemslot_bit_test(map, (unsigned int)port);
+}
+
+/*
+ * Index ring over a power-of-two array. One producer and one consumer, and the
+ * caller serializes them.
+ */
+struct gemslot_ring {
+	__u32 head;
+	__u32 tail;
+	__u32 mask;
+};
+
+static inline void gemslot_ring_init(struct gemslot_ring *r, __u32 capacity)
+{
+	r->head = 0;
+	r->tail = 0;
+	r->mask = capacity - 1;
+}
+
+static inline __u32 gemslot_ring_count(const struct gemslot_ring *r)
+{
+	return (r->head - r->tail) & r->mask;
+}
+
+static inline __u32 gemslot_ring_space(const struct gemslot_ring *r)
+{
+	return r->mask - gemslot_ring_count(r);
+}
+
+/* The array index to write, or -1 when the ring is full. */
+static inline int gemslot_ring_push(struct gemslot_ring *r)
+{
+	__u32 next = (r->head + 1) & r->mask;
+
+	if (next == r->tail)
+		return -1;
+
+	r->head = next;
+	return (int)((next - 1) & r->mask);
+}
+
+/* The array index to read, or -1 when the ring is empty. */
+static inline int gemslot_ring_pop(struct gemslot_ring *r)
+{
+	__u32 tail = r->tail;
+
+	if (tail == r->head)
+		return -1;
+
+	r->tail = (tail + 1) & r->mask;
+	return (int)tail;
+}
+
+#endif /* _MACB_GEMSLOT_LIB_H */
