index 000000000..5565929f6
--- /dev/null
+++ b/drivers/net/ethernet/cadence/macb_gemslot.c
@@ -0,0 +1,1163 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * GEM slot fast path for the Zynq-7000 GEM.
+ *
+ * A reserved-memory pool holds two rings of fixed-size slots. The PL writes
+ * finished frames into transmit slots and reads host frames out of receive
+ * slots. The kernel moves slot indices between GEM and the PL without copying
+ * samples. User space configures and stops the streams.
+ */
+
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/etherdevice.h>
+#include <linux/fs.h>
+#include <linux/io.h>
+#include <linux/interrupt.h>
+#include <linux/kthread.h>
+#include <linux/jiffies.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/sched.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <asm/unaligned.h>
+
+#include "macb.h"
+#include "macb_gemslot.h"
+
+#define GEMSLOT_DDRC_MODE_STS_PHYS 0xf8006054
+
+static u32 gemslot_slots = GEMSLOT_SLOT_COUNT;
+#define GEMSLOT_TX_IRQ_BATCH 8u
+module_param_named(slots, gemslot_slots, uint, 0444);
+MODULE_PARM_DESC(slots, "Slots per ring in the GEM slot pool");
+
+bool macb_gemslot_jumbo = true;
+module_param_named(jumbo, macb_gemslot_jumbo, bool, 0444);
+MODULE_PARM_DESC(jumbo, "Offer a 9000 byte MTU and jumbo receive buffers");
+
+bool macb_gemslot_fast_tx;
+module_param_named(fast_tx, macb_gemslot_fast_tx, bool, 0644);
+MODULE_PARM_DESC(fast_tx, "Transmit GEM slots from their DMA descriptors");
+
+static struct gemslot_dev *gemslot_of_file(struct file *file)
+{
+	return container_of(file->private_data, struct gemslot_dev, misc);
+}
+
+static void gemslot_pump_wake(struct gemslot_dev *gs)
+{
+	if (gs->pump_task) {
+		atomic_set(&gs->pump_event, 1);
+		wake_up_interruptible(&gs->pump_wq);
+	}
+}
+
+void macb_gemslot_wake(struct gemslot_dev *gs)
+{
+	wake_up_interruptible(&gs->wq);
+	if (READ_ONCE(gs->direct[GEMSLOT_STREAM_TX].active))
+		gemslot_pump_wake(gs);
+}
+
+void macb_gemslot_tx_done(struct gemslot_dev *gs, u16 slot, u16 len)
+{
+	unsigned long flags;
+	int idx;
+
+	spin_lock_irqsave(&gs->tx_lock, flags);
+	idx = gemslot_ring_push(&gs->tx_comp);
+	if (idx >= 0) {
+		gs->tx_comp_buf[idx].slot = slot;
+		gs->tx_comp_buf[idx].len = len;
+		gs->tx_frames++;
+	}
+	spin_unlock_irqrestore(&gs->tx_lock, flags);
+
+	/* This runs per completed frame, so keep it to a list check when the
+	 * daemon is not in GEMSLOT_WAIT.
+	 */
+	if (waitqueue_active(&gs->wq))
+		wake_up_interruptible(&gs->wq);
+	if (idx < 0)
+		netdev_warn_once(gs->bp->dev,
+				 "gemslot: transmit completion ring overrun, slot %u lost\n",
+				 slot);
+}
+
+int macb_gemslot_take_slot(struct gemslot_dev *gs)
+{
+	unsigned long flags;
+	int idx;
+	int slot = -1;
+
+	spin_lock_irqsave(&gs->rx_lock, flags);
+	idx = gemslot_ring_pop(&gs->rx_free);
+	if (idx >= 0)
+		slot = gs->rx_free_buf[idx];
+	else
+		gs->rx_starved++;
+	spin_unlock_irqrestore(&gs->rx_lock, flags);
+
+	return slot;
+}
+
+void macb_gemslot_put_slot(struct gemslot_dev *gs, u16 slot)
+{
+	unsigned long flags;
+	int idx;
+
+	spin_lock_irqsave(&gs->rx_lock, flags);
+	idx = gemslot_ring_push(&gs->rx_free);
+	if (idx >= 0)
+		gs->rx_free_buf[idx] = slot;
+	spin_unlock_irqrestore(&gs->rx_lock, flags);
+
+	/* The free ring is larger than the slot count, so a push cannot fail
+	 * unless a slot was returned twice.
+	 */
+	if (idx < 0)
+		netdev_warn_once(gs->bp->dev,
+				 "gemslot: free ring full, receive slot %u returned twice\n",
+				 slot);
+}
+
+/* Take a slot back from the daemon, refusing one it was not holding. */
+int macb_gemslot_return_slot(struct gemslot_dev *gs, u16 slot)
+{
+	unsigned long flags;
+	int idx;
+
+	spin_lock_irqsave(&gs->rx_lock, flags);
+	if (!gemslot_bit_test(gs->rx_outstanding, slot)) {
+		spin_unlock_irqrestore(&gs->rx_lock, flags);
+		return -EINVAL;
+	}
+	gemslot_bit_assign(gs->rx_outstanding, slot, 0);
+
+	idx = gemslot_ring_push(&gs->rx_free);
+	if (idx >= 0)
+		gs->rx_free_buf[idx] = slot;
+	spin_unlock_irqrestore(&gs->rx_lock, flags);
+
+	return idx < 0 ? -ENOSPC : 0;
+}
+
+void macb_gemslot_deliver(struct gemslot_dev *gs, u16 slot, u16 len)
+{
+	unsigned long flags;
+	int idx;
+
+	spin_lock_irqsave(&gs->rx_lock, flags);
+	idx = gemslot_ring_push(&gs->rx_steer);
+	if (idx >= 0) {
+		gs->rx_steer_buf[idx].slot = slot;
+		gs->rx_steer_buf[idx].len = len;
+		gs->rx_steered++;
+		gemslot_bit_assign(gs->rx_outstanding, slot, 1);
+	}
+	spin_unlock_irqrestore(&gs->rx_lock, flags);
+
+	/* A daemon that stops reading must not leak the slot out of the ring. */
+	if (idx < 0)
+		macb_gemslot_put_slot(gs, slot);
+}
+
+static u32 gemslot_tx_pending(struct gemslot_dev *gs)
+{
+	unsigned long flags;
+	u32 n;
+
+	spin_lock_irqsave(&gs->tx_lock, flags);
+	n = gemslot_ring_count(&gs->tx_comp);
+	spin_unlock_irqrestore(&gs->tx_lock, flags);
+
+	return n;
+}
+
+static u32 gemslot_rx_pending(struct gemslot_dev *gs)
+{
+	unsigned long flags;
+	u32 n;
+
+	spin_lock_irqsave(&gs->rx_lock, flags);
+	n = gemslot_ring_count(&gs->rx_steer);
+	spin_unlock_irqrestore(&gs->rx_lock, flags);
+
+	return n;
+}
+
+/* Seed the receive pool once, before GEM owns any descriptor. */
+static void macb_gemslot_init_pool(struct macb *bp)
+{
+	struct gemslot_dev *gs = bp->gemslot;
+	unsigned long flags;
+	u32 i;
+
+	if (!gs)
+		return;
+
+	spin_lock_irqsave(&gs->rx_lock, flags);
+	gemslot_ring_init(&gs->rx_steer, GEMSLOT_STEER_RING);
+	gemslot_ring_init(&gs->rx_free, GEMSLOT_FREE_RING);
+	memset(gs->rx_outstanding, 0, BITS_TO_BYTES(gs->slot_count));
+	for (i = 0; i < gs->slot_count; i++) {
+		int idx = gemslot_ring_push(&gs->rx_free);
+
+		if (idx < 0)
+			break;
+		gs->rx_free_buf[idx] = (u16)i;
+	}
+	spin_unlock_irqrestore(&gs->rx_lock, flags);
+}
+
+static u32 gemslot_csr_read(struct gemslot_dev *gs, u32 addr)
+{
+	return readl((u8 __iomem *)gs->csr + addr);
+}
+
+static void gemslot_csr_write(struct gemslot_dev *gs, u32 addr, u32 value)
+{
+	writel(value, (u8 __iomem *)gs->csr + addr);
+}
+
+static bool gemslot_csr_valid(struct gemslot_dev *gs, u32 addr)
+{
+	return gs->csr && addr <= gs->csr_size - sizeof(u32) &&
+	       !(addr & (sizeof(u32) - 1));
+}
+
+static u64 gemslot_packet_end(struct gemslot_dev *gs, u16 slot, u32 format,
+			      u16 frame_len, u64 previous)
+{
+	const u8 *frame = (u8 *)gemslot_va(gs, false, slot) +
+			  GEMSLOT_FRAME_OFFSET;
+	const u8 *vita = frame + ETH_HLEN + 20 + 8;
+	u32 header, payload, samples;
+	u64 ticks;
+
+	if (frame_len < ETH_HLEN + 20 + 8 + 24)
+		return previous;
+	header = get_unaligned_be32(vita);
+	if (header >> 28 != 1 || !(header & BIT(27)) ||
+	    (header & (0xf << 20)) != BIT(20))
+		return previous;
+	payload = (header & 0xffff) * sizeof(u32);
+	if (payload > frame_len - ETH_HLEN - 20 - 8)
+		return previous;
+	if (payload < 24 + ((header & BIT(26)) ? sizeof(u32) : 0))
+		return previous;
+	payload -= 24 + ((header & BIT(26)) ? sizeof(u32) : 0);
+	switch (format) {
+	case 0:
+		samples = payload / 3;
+		break;
+	case 1:
+		samples = payload / 2;
+		break;
+	case 2:
+		samples = payload / 33 * 16;
+		break;
+	default:
+		return previous;
+	}
+	ticks = get_unaligned_be64(vita + 16);
+	return max(previous, ticks + samples);
+}
+
+static bool gemslot_pump_rx(struct gemslot_dev *gs,
+			    struct gemslot_direct_stream *stream)
+{
+	struct gemslot_tx_entry batch[GEMSLOT_BATCH_MAX];
+	u32 produced, count, i;
+	unsigned long flags;
+	bool progress = false;
+	int accepted;
+
+	spin_lock_irqsave(&gs->tx_lock, flags);
+	while (gemslot_ring_count(&gs->tx_comp)) {
+		int idx = gemslot_ring_pop(&gs->tx_comp);
+		u16 expected = stream->config.slot_first +
+			(stream->released - stream->base) % stream->config.slot_count;
+
+		if (gs->tx_comp_buf[idx].slot != expected) {
+			stream->dropped++;
+			gemslot_csr_write(gs, stream->config.ctrl, 0);
+			stream->stopping = true;
+			continue;
+		}
+		stream->released++;
+		stream->completed++;
+		progress = true;
+	}
+	spin_unlock_irqrestore(&gs->tx_lock, flags);
+	if (progress)
+		gemslot_csr_write(gs, stream->config.released, stream->released);
+
+	produced = gemslot_csr_read(gs, stream->config.produced);
+	stream->produced += (u32)(produced - stream->last_produced);
+	stream->last_produced = produced;
+	gemslot_csr_write(gs, stream->config.observed, produced);
+	if ((u32)(produced - stream->released) > stream->config.slot_count) {
+		stream->dropped += produced - stream->released -
+				   stream->config.slot_count;
+		gemslot_csr_write(gs, stream->config.ctrl, 0);
+		stream->stopping = true;
+		return false;
+	}
+
+	count = min_t(u32, produced - stream->queued, GEMSLOT_BATCH_MAX);
+	for (i = 0; i < count; i++) {
+		batch[i].slot = stream->config.slot_first +
+			(stream->queued + i - stream->base) %
+			stream->config.slot_count;
+		batch[i].len = stream->config.frame_len;
+	}
+	if (!count)
+		return progress;
+	accepted = macb_gemslot_submit(gs->bp, batch, count);
+	if (accepted < 0) {
+		stream->dropped += count;
+		gemslot_csr_write(gs, stream->config.ctrl, 0);
+		stream->stopping = true;
+		return progress;
+	}
+	stream->queued += accepted;
+	stream->submitted += accepted;
+	return progress || accepted != 0;
+}
+
+static bool gemslot_pump_tx(struct gemslot_dev *gs,
+			    struct gemslot_direct_stream *stream)
+{
+	unsigned long flags;
+	u32 ready, i;
+	bool progress = false;
+
+	ready = gemslot_csr_read(gs, stream->config.consumed_count);
+	for (i = 0; i < ready &&
+	     stream->inflight_tail != stream->inflight_head; i++) {
+		u32 index = stream->inflight_tail++ % GEMSLOT_BATCH_MAX;
+		u16 slot = stream->inflight[index];
+
+		gemslot_csr_read(gs, stream->config.consumed);
+		stream->consumed_ticks = max(stream->consumed_ticks,
+					     stream->end_ticks[index]);
+		if (macb_gemslot_return_slot(gs, slot)) {
+			stream->dropped++;
+			gemslot_csr_write(gs, stream->config.ctrl, 0);
+			stream->stopping = true;
+		}
+		stream->completed++;
+		progress = true;
+	}
+	if (i != ready)
+		stream->dropped += ready - i;
+
+	while (stream->inflight_head - stream->inflight_tail <
+	       GEMSLOT_BATCH_MAX) {
+		struct gemslot_rx_entry entry;
+		int idx;
+		u32 index;
+
+		spin_lock_irqsave(&gs->rx_lock, flags);
+		idx = gemslot_ring_pop(&gs->rx_steer);
+		if (idx >= 0)
+			entry = gs->rx_steer_buf[idx];
+		spin_unlock_irqrestore(&gs->rx_lock, flags);
+		if (idx < 0)
+			break;
+		index = stream->inflight_head++ % GEMSLOT_BATCH_MAX;
+		stream->inflight[index] = entry.slot;
+		stream->end_ticks[index] = gemslot_packet_end(gs, entry.slot,
+			stream->config.format, entry.len, stream->consumed_ticks);
+		gemslot_csr_write(gs, stream->config.submit,
+				  (u32)entry.len << 16 | entry.slot);
+		stream->submitted++;
+		progress = true;
+	}
+	stream->produced = stream->submitted;
+	return progress;
+}
+
+static bool gemslot_direct_drained(struct gemslot_dev *gs,
+				   struct gemslot_direct_stream *stream);
+
+static int gemslot_pump_thread(void *data)
+{
+	struct gemslot_dev *gs = data;
+
+	while (!kthread_should_stop()) {
+		bool progress;
+		int budget = 16;
+		long timeout = READ_ONCE(gs->direct[GEMSLOT_STREAM_RX].active) ||
+			READ_ONCE(gs->direct[GEMSLOT_STREAM_TX].active) ?
+			msecs_to_jiffies(1) : MAX_SCHEDULE_TIMEOUT;
+
+		wait_event_interruptible_timeout(gs->pump_wq,
+			atomic_xchg(&gs->pump_event, 0) ||
+			kthread_should_stop(), timeout);
+		if (kthread_should_stop())
+			break;
+		mutex_lock(&gs->pump_lock);
+		macb_gemslot_poll_tx(gs->bp,
+			gs->direct[GEMSLOT_STREAM_RX].active);
+		do {
+			progress = false;
+			if (gs->direct[GEMSLOT_STREAM_RX].active)
+				progress |= gemslot_pump_rx(gs,
+					&gs->direct[GEMSLOT_STREAM_RX]);
+			if (gs->direct[GEMSLOT_STREAM_TX].active)
+				progress |= gemslot_pump_tx(gs,
+					&gs->direct[GEMSLOT_STREAM_TX]);
+		} while (progress && --budget);
+		if (gs->direct[GEMSLOT_STREAM_RX].stopping &&
+		    gemslot_direct_drained(gs,
+			&gs->direct[GEMSLOT_STREAM_RX])) {
+			gs->direct[GEMSLOT_STREAM_RX].active = false;
+			gs->direct[GEMSLOT_STREAM_RX].stopping = false;
+		}
+		if (gs->direct[GEMSLOT_STREAM_TX].stopping &&
+		    gemslot_direct_drained(gs,
+			&gs->direct[GEMSLOT_STREAM_TX])) {
+			gs->direct[GEMSLOT_STREAM_TX].active = false;
+			gs->direct[GEMSLOT_STREAM_TX].stopping = false;
+		}
+		if (!gs->direct[GEMSLOT_STREAM_RX].active)
+			macb_gemslot_poll_tx(gs->bp, false);
+		mutex_unlock(&gs->pump_lock);
+		if (atomic_cmpxchg(&gs->pump_irq_masked, 1, 0) == 1)
+			enable_irq(gs->pump_irq);
+	}
+	return 0;
+}
+
+static irqreturn_t gemslot_pump_interrupt(int irq, void *data)
+{
+	struct gemslot_dev *gs = data;
+
+	disable_irq_nosync(irq);
+	atomic_set(&gs->pump_irq_masked, 1);
+	gemslot_pump_wake(gs);
+	return IRQ_HANDLED;
+}
+
+static bool gemslot_direct_drained(struct gemslot_dev *gs,
+				   struct gemslot_direct_stream *stream)
+{
+	if (stream->config.direction == GEMSLOT_STREAM_RX)
+		return stream->queued == stream->released &&
+		       stream->queued ==
+		       gemslot_csr_read(gs, stream->config.produced);
+	return stream->inflight_head == stream->inflight_tail &&
+	       !gemslot_rx_pending(gs);
+}
+
+static void gemslot_direct_quiesce(struct gemslot_dev *gs,
+				   struct gemslot_direct_stream *stream)
+{
+	gemslot_csr_write(gs, stream->config.ctrl, 0);
+	if (stream->config.direction == GEMSLOT_STREAM_RX)
+		gemslot_csr_write(gs, stream->config.irq_threshold, 0);
+	else {
+		gemslot_csr_write(gs, stream->config.tx_irq_threshold, 0);
+		gemslot_bit_assign(gs->portmap, stream->config.udp_port, 0);
+	}
+	stream->stopping = true;
+	gemslot_pump_wake(gs);
+}
+
+void macb_gemslot_link_down(struct gemslot_dev *gs)
+{
+	u32 direction;
+
+	if (!gs)
+		return;
+	mutex_lock(&gs->pump_lock);
+	for (direction = GEMSLOT_STREAM_RX;
+	     direction <= GEMSLOT_STREAM_TX; direction++) {
+		if (gs->direct[direction].active)
+			gemslot_direct_quiesce(gs, &gs->direct[direction]);
+	}
+	mutex_unlock(&gs->pump_lock);
+}
+
+void macb_gemslot_fault(struct gemslot_dev *gs)
+{
+	struct gemslot_direct_stream *stream;
+
+	if (!gs)
+		return;
+	stream = &gs->direct[GEMSLOT_STREAM_RX];
+	if (READ_ONCE(stream->active)) {
+		gemslot_csr_write(gs, stream->config.ctrl, 0);
+		gemslot_csr_write(gs, stream->config.irq_threshold, 0);
+		WRITE_ONCE(stream->stopping, true);
+	}
+	stream = &gs->direct[GEMSLOT_STREAM_TX];
+	if (READ_ONCE(stream->active)) {
+		gemslot_csr_write(gs, stream->config.ctrl, 0);
+		gemslot_csr_write(gs, stream->config.tx_irq_threshold, 0);
+		gemslot_bit_assign(gs->portmap, stream->config.udp_port, 0);
+		WRITE_ONCE(stream->stopping, true);
+	}
+	gemslot_pump_wake(gs);
+}
+
+static int gemslot_direct_stop(struct gemslot_dev *gs, struct file *file,
+			       u32 direction)
+{
+	struct gemslot_direct_stream *stream;
+	unsigned long deadline = jiffies + msecs_to_jiffies(1000);
+	int ret = 0;
+
+	if (direction > GEMSLOT_STREAM_TX)
+		return -EINVAL;
+	stream = &gs->direct[direction];
+	mutex_lock(&gs->pump_lock);
+	if (stream->owner != file) {
+		mutex_unlock(&gs->pump_lock);
+		return -ENOENT;
+	}
+	if (!stream->active && !stream->stopping) {
+		mutex_unlock(&gs->pump_lock);
+		return 0;
+	}
+	gemslot_direct_quiesce(gs, stream);
+	mutex_unlock(&gs->pump_lock);
+
+	do {
+		gemslot_pump_wake(gs);
+		msleep(1);
+		mutex_lock(&gs->pump_lock);
+		if (gemslot_direct_drained(gs, stream)) {
+			stream->active = false;
+			stream->stopping = false;
+			if (direction == GEMSLOT_STREAM_RX)
+				macb_gemslot_poll_tx(gs->bp, false);
+			mutex_unlock(&gs->pump_lock);
+			return 0;
+		}
+		mutex_unlock(&gs->pump_lock);
+	} while (time_before(jiffies, deadline));
+
+	ret = -ETIMEDOUT;
+	return ret;
+}
+
+static long gemslot_direct_start(struct gemslot_dev *gs, struct file *file,
+				 void __user *arg)
+{
+	struct gemslot_stream_config cfg;
+	struct gemslot_direct_stream *stream;
+	u32 first, last;
+	long ret = 0;
+
+	if (copy_from_user(&cfg, arg, sizeof(cfg)))
+		return -EFAULT;
+	if (!gs->csr || !gs->pump_task || gs->pump_irq <= 0)
+		return -ENODEV;
+	if (cfg.direction > GEMSLOT_STREAM_TX || cfg.instance >= 4 ||
+	    !cfg.slot_count || cfg.slot_first >= gs->slot_count ||
+	    cfg.slot_count > gs->slot_count - cfg.slot_first ||
+	    !gemslot_csr_valid(gs, cfg.ctrl) || cfg.format > 2)
+		return -EINVAL;
+	if (cfg.direction == GEMSLOT_STREAM_RX) {
+		if (!cfg.frame_len || cfg.frame_len >
+		    min_t(u32, gs->slot_size - GEMSLOT_FRAME_OFFSET,
+			  gs->bp->dev->mtu + ETH_HLEN) ||
+		    !gemslot_csr_valid(gs, cfg.produced) ||
+		    !gemslot_csr_valid(gs, cfg.observed) ||
+		    !gemslot_csr_valid(gs, cfg.released) ||
+		    !gemslot_csr_valid(gs, cfg.irq_threshold))
+			return -EINVAL;
+	} else if (!cfg.udp_port || cfg.udp_port > U16_MAX ||
+		   !gemslot_csr_valid(gs, cfg.submit) ||
+		   !gemslot_csr_valid(gs, cfg.consumed) ||
+		   !gemslot_csr_valid(gs, cfg.consumed_count) ||
+		   !gemslot_csr_valid(gs, cfg.tx_irq_threshold)) {
+		return -EINVAL;
+	}
+	if (!netif_running(gs->bp->dev))
+		return -ENETDOWN;
+	stream = &gs->direct[cfg.direction];
+	mutex_lock(&gs->pump_lock);
+	if (stream->active || stream->stopping) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (cfg.direction == GEMSLOT_STREAM_RX) {
+		if (gemslot_tx_pending(gs)) {
+			ret = -EBUSY;
+			goto out;
+		}
+	} else if (gemslot_rx_pending(gs) ||
+		   gemslot_bit_test(gs->portmap, cfg.udp_port)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	memset(stream, 0, sizeof(*stream));
+	stream->config = cfg;
+	stream->owner = file;
+	if (cfg.direction == GEMSLOT_STREAM_RX) {
+		stream->base = gemslot_csr_read(gs, cfg.produced);
+		stream->last_produced = stream->base;
+		stream->queued = stream->base;
+		stream->released = stream->base;
+		gemslot_csr_write(gs, cfg.observed, stream->base);
+		gemslot_csr_write(gs, cfg.released, stream->base);
+		gemslot_csr_write(gs, cfg.irq_threshold, 8);
+	} else {
+		first = gemslot_csr_read(gs, cfg.consumed_count);
+		for (last = 0; last < first; last++)
+			gemslot_csr_read(gs, cfg.consumed);
+		gemslot_bit_assign(gs->portmap, cfg.udp_port, 1);
+		gemslot_csr_write(gs, cfg.tx_irq_threshold,
+				  GEMSLOT_TX_IRQ_BATCH);
+	}
+	stream->active = true;
+	gemslot_pump_wake(gs);
+out:
+	mutex_unlock(&gs->pump_lock);
+	return ret;
+}
+
+static long gemslot_direct_status(struct gemslot_dev *gs, struct file *file,
+				  void __user *arg)
+{
+	struct gemslot_stream_status status;
+	struct gemslot_direct_stream *stream;
+
+	if (copy_from_user(&status, arg, sizeof(status)))
+		return -EFAULT;
+	if (status.direction > GEMSLOT_STREAM_TX)
+		return -EINVAL;
+	mutex_lock(&gs->pump_lock);
+	stream = &gs->direct[status.direction];
+	if (stream->owner != file) {
+		mutex_unlock(&gs->pump_lock);
+		return -ENOENT;
+	}
+	status.active = stream->active && !stream->stopping;
+	status.produced = stream->produced;
+	status.submitted = stream->submitted;
+	status.completed = stream->completed;
+	status.consumed_ticks = stream->consumed_ticks;
+	status.dropped = stream->dropped;
+	mutex_unlock(&gs->pump_lock);
+	return copy_to_user(arg, &status, sizeof(status)) ? -EFAULT : 0;
+}
+
+static long gemslot_get_info(struct gemslot_dev *gs, void __user *arg)
+{
+	struct gemslot_info info = {
+		.pool_phys = (u32)gs->pool_phys,
+		.pool_size = (u32)gs->pool_size,
+		.slot_size = gs->slot_size,
+		.slot_count = gs->slot_count,
+		.tx_offset = gs->tx_offset,
+		.rx_offset = gs->rx_offset,
+	};
+
+	return copy_to_user(arg, &info, sizeof(info)) ? -EFAULT : 0;
+}
+
+static long gemslot_tx_submit(struct gemslot_dev *gs, void __user *arg)
+{
+	struct gemslot_tx_batch batch;
+	u32 max_len;
+	u32 i;
+
+	if (READ_ONCE(gs->direct[GEMSLOT_STREAM_RX].active))
+		return -EBUSY;
+
+	if (copy_from_user(&batch, arg, sizeof(batch)))
+		return -EFAULT;
+	if (batch.count > GEMSLOT_BATCH_MAX)
+		return -EINVAL;
+
+	/* GEM appends the FCS, so a frame reaches the wire four bytes longer. */
+	max_len = min_t(u32, gs->slot_size - GEMSLOT_FRAME_OFFSET,
+			gs->bp->dev->mtu + ETH_HLEN);
+
+	for (i = 0; i < batch.count; i++) {
+		if (batch.entries[i].slot >= gs->slot_count)
+			return -EINVAL;
+		if (batch.entries[i].len < ETH_ZLEN ||
+		    batch.entries[i].len > max_len)
+			return -EINVAL;
+	}
+
+	return macb_gemslot_submit(gs->bp, batch.entries, batch.count);
+}
+
+static long gemslot_tx_completions(struct gemslot_dev *gs, void __user *arg)
+{
+	struct gemslot_tx_batch batch = { .count = 0 };
+	unsigned long flags;
+
+	if (READ_ONCE(gs->direct[GEMSLOT_STREAM_RX].active))
+		return -EBUSY;
+
+	spin_lock_irqsave(&gs->tx_lock, flags);
+	while (batch.count < GEMSLOT_BATCH_MAX) {
+		int idx = gemslot_ring_pop(&gs->tx_comp);
+
+		if (idx < 0)
+			break;
+		batch.entries[batch.count++] = gs->tx_comp_buf[idx];
+	}
+	spin_unlock_irqrestore(&gs->tx_lock, flags);
+
+	if (copy_to_user(arg, &batch, sizeof(batch)))
+		return -EFAULT;
+
+	return batch.count;
+}
+
+static long gemslot_rx_steer(struct gemslot_dev *gs, void __user *arg)
+{
+	struct gemslot_steer steer;
+
+	if (READ_ONCE(gs->direct[GEMSLOT_STREAM_TX].active))
+		return -EBUSY;
+
+	if (copy_from_user(&steer, arg, sizeof(steer)))
+		return -EFAULT;
+	if (!steer.udp_port || steer.udp_port > U16_MAX)
+		return -EINVAL;
+
+	gemslot_bit_assign(gs->portmap, steer.udp_port, steer.enable ? 1 : 0);
+
+	return 0;
+}
+
+static long gemslot_rx_poll(struct gemslot_dev *gs, void __user *arg)
+{
+	struct gemslot_rx_batch batch = { .count = 0 };
+	unsigned long flags;
+
+	if (READ_ONCE(gs->direct[GEMSLOT_STREAM_TX].active))
+		return -EBUSY;
+
+	spin_lock_irqsave(&gs->rx_lock, flags);
+	while (batch.count < GEMSLOT_BATCH_MAX) {
+		int idx = gemslot_ring_pop(&gs->rx_steer);
+
+		if (idx < 0)
+			break;
+		batch.entries[batch.count++] = gs->rx_steer_buf[idx];
+	}
+	spin_unlock_irqrestore(&gs->rx_lock, flags);
+
+	if (copy_to_user(arg, &batch, sizeof(batch)))
+		return -EFAULT;
+
+	return batch.count;
+}
+
+static long gemslot_rx_return(struct gemslot_dev *gs, void __user *arg)
+{
+	struct gemslot_rx_batch batch;
+	u32 i;
+
+	if (READ_ONCE(gs->direct[GEMSLOT_STREAM_TX].active))
+		return -EBUSY;
+
+	if (copy_from_user(&batch, arg, sizeof(batch)))
+		return -EFAULT;
+	if (batch.count > GEMSLOT_BATCH_MAX)
+		return -EINVAL;
+
+	for (i = 0; i < batch.count; i++)
+		if (batch.entries[i].slot >= gs->slot_count)
+			return -EINVAL;
+
+	for (i = 0; i < batch.count; i++) {
+		int err = macb_gemslot_return_slot(gs, batch.entries[i].slot);
+
+		if (err)
+			return i ? (long)i : err;
+	}
+
+	return batch.count;
+}
+
+static bool gemslot_wait_ready(struct gemslot_dev *gs,
+			       const struct gemslot_wait *w)
+{
+	if ((w->events & GEMSLOT_EVENT_TX) &&
+	    gemslot_tx_pending(gs) >= max(w->tx_threshold, 1u))
+		return true;
+	if ((w->events & GEMSLOT_EVENT_RX) &&
+	    gemslot_rx_pending(gs) >= max(w->rx_threshold, 1u))
+		return true;
+
+	return false;
+}
+
+static long gemslot_wait(struct gemslot_dev *gs, void __user *arg)
+{
+	struct gemslot_wait w;
+	long ret = 0;
+
+	if (copy_from_user(&w, arg, sizeof(w)))
+		return -EFAULT;
+	if (!(w.events & (GEMSLOT_EVENT_TX | GEMSLOT_EVENT_RX)))
+		return -EINVAL;
+
+	if (w.timeout_ms && !gemslot_wait_ready(gs, &w)) {
+		ret = wait_event_interruptible_timeout(gs->wq,
+						       gemslot_wait_ready(gs, &w),
+						       msecs_to_jiffies(w.timeout_ms));
+		if (ret < 0)
+			return ret;
+	}
+
+	w.tx_pending = gemslot_tx_pending(gs);
+	w.rx_pending = gemslot_rx_pending(gs);
+
+	if (copy_to_user(arg, &w, sizeof(w)))
+		return -EFAULT;
+
+	return 0;
+}
+
+static long gemslot_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct gemslot_dev *gs = gemslot_of_file(file);
+	void __user *p = (void __user *)arg;
+
+	switch (cmd) {
+	case GEMSLOT_GET_INFO:
+		return gemslot_get_info(gs, p);
+	case GEMSLOT_TX_SUBMIT:
+		return gemslot_tx_submit(gs, p);
+	case GEMSLOT_TX_COMPLETIONS:
+		return gemslot_tx_completions(gs, p);
+	case GEMSLOT_RX_STEER:
+		return gemslot_rx_steer(gs, p);
+	case GEMSLOT_RX_POLL:
+		return gemslot_rx_poll(gs, p);
+	case GEMSLOT_RX_RETURN:
+		return gemslot_rx_return(gs, p);
+	case GEMSLOT_WAIT:
+		return gemslot_wait(gs, p);
+	case GEMSLOT_STREAM_START:
+		return gemslot_direct_start(gs, file, p);
+	case GEMSLOT_STREAM_STOP: {
+		u32 direction;
+
+		if (get_user(direction, (u32 __user *)p))
+			return -EFAULT;
+		return gemslot_direct_stop(gs, file, direction);
+	}
+	case GEMSLOT_STREAM_STATUS:
+		return gemslot_direct_status(gs, file, p);
+	case GEMSLOT_GET_CAPS: {
+		u32 caps = gs->csr && gs->pump_task && gs->pump_irq > 0 ?
+			   GEMSLOT_CAP_KERNEL_PUMP : 0;
+
+		return put_user(caps, (u32 __user *)p);
+	}
+	default:
+		return -ENOTTY;
+	}
+}
+
+static int gemslot_release(struct inode *inode, struct file *file)
+{
+	struct gemslot_dev *gs = gemslot_of_file(file);
+	u32 direction;
+
+	for (direction = GEMSLOT_STREAM_RX;
+	     direction <= GEMSLOT_STREAM_TX; direction++) {
+		if (READ_ONCE(gs->direct[direction].owner) == file)
+			gemslot_direct_stop(gs, file, direction);
+	}
+	mutex_lock(&gs->pump_lock);
+	for (direction = GEMSLOT_STREAM_RX;
+	     direction <= GEMSLOT_STREAM_TX; direction++) {
+		if (gs->direct[direction].owner == file)
+			gs->direct[direction].owner = NULL;
+	}
+	mutex_unlock(&gs->pump_lock);
+	return 0;
+}
+
+static int gemslot_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct gemslot_dev *gs = gemslot_of_file(file);
+	unsigned long size = vma->vm_end - vma->vm_start;
+
+	if (vma->vm_pgoff)
+		return -EINVAL;
+	if (size > gs->pool_size)
+		return -EINVAL;
+
+	vma->vm_page_prot = pgprot_writecombine(vma->vm_page_prot);
+
+	return remap_pfn_range(vma, vma->vm_start,
+			       PHYS_PFN(gs->pool_phys), size,
+			       vma->vm_page_prot);
+}
+
+static const struct file_operations gemslot_fops = {
+	.owner		= THIS_MODULE,
+	.unlocked_ioctl	= gemslot_ioctl,
+	.release	= gemslot_release,
+	.compat_ioctl	= compat_ptr_ioctl,
+	.mmap		= gemslot_mmap,
+	.llseek		= no_llseek,
+};
+
+/*
+ * Bring-up counters. rx_oversize is the one to read first if jumbo receive is
+ * in doubt: a part that does not implement it decodes the frame length too
+ * long, and every such frame lands here.
+ */
+static int gemslot_stats_show(struct seq_file *m, void *unused)
+{
+	struct gemslot_dev *gs = m->private;
+	unsigned long flags;
+	u32 comp, steer, free;
+
+	spin_lock_irqsave(&gs->tx_lock, flags);
+	comp = gemslot_ring_count(&gs->tx_comp);
+	spin_unlock_irqrestore(&gs->tx_lock, flags);
+
+	spin_lock_irqsave(&gs->rx_lock, flags);
+	steer = gemslot_ring_count(&gs->rx_steer);
+	free = gemslot_ring_count(&gs->rx_free);
+	spin_unlock_irqrestore(&gs->rx_lock, flags);
+
+	seq_printf(m, "tx_frames      %llu\n", gs->tx_frames);
+	seq_printf(m, "rx_steered     %llu\n", gs->rx_steered);
+	seq_printf(m, "rx_copied      %llu\n", gs->rx_copied);
+	seq_printf(m, "rx_starved     %llu\n", gs->rx_starved);
+	seq_printf(m, "rx_oversize    %llu\n", gs->rx_oversize);
+	seq_printf(m, "irq_total      %u\n", READ_ONCE(gs->irq_total));
+	seq_printf(m, "irq_rcomp      %u\n", READ_ONCE(gs->irq_rcomp));
+	seq_printf(m, "irq_tcomp      %u\n", READ_ONCE(gs->irq_tcomp));
+	seq_printf(m, "irq_txubr      %u\n", READ_ONCE(gs->irq_txubr));
+	seq_printf(m, "irq_rxubr      %u\n", READ_ONCE(gs->irq_rxubr));
+	seq_printf(m, "irq_rovr       %u\n", READ_ONCE(gs->irq_rovr));
+	seq_printf(m, "irq_txerr      %u\n", READ_ONCE(gs->irq_txerr));
+	seq_printf(m, "rx_poll_calls  %llu\n", gs->rx_poll_calls);
+	seq_printf(m, "rx_poll_budget %llu\n", gs->rx_poll_budget);
+	seq_printf(m, "rx_poll_max_work %u\n", gs->rx_poll_max_work);
+	seq_printf(m, "rx_poll_max_ns %llu\n", gs->rx_poll_max_ns);
+	seq_printf(m, "rx_poll_busy_gap_max_ns %llu\n",
+		   gs->rx_poll_busy_gap_max_ns);
+	seq_printf(m, "rx_desc_ready_min %u\n", gs->rx_desc_ready_min);
+	seq_printf(m, "rx_desc_ready_seen %u\n", gs->rx_desc_ready_seen);
+	seq_printf(m, "rx_overrun_seen %u\n", gs->rx_overrun_seen);
+	seq_printf(m, "rx_overrun_from_poll %u\n",
+		   gs->rx_overrun_from_poll);
+	seq_printf(m, "rx_overrun_isr 0x%08x\n", gs->rx_overrun_isr);
+	seq_printf(m, "rx_overrun_rsr 0x%08x\n", gs->rx_overrun_rsr);
+	seq_printf(m, "rx_overrun_desc_ready %u\n",
+		   gs->rx_overrun_desc_ready);
+	seq_printf(m, "rx_overrun_used_count %u\n",
+		   gs->rx_overrun_used_count);
+	seq_printf(m, "rx_overrun_dma_ready %u\n",
+		   gs->rx_overrun_dma_ready);
+	seq_printf(m, "rx_overrun_used_prefix %u\n",
+		   gs->rx_overrun_used_prefix);
+	seq_printf(m, "rx_overrun_poll_age_ns %llu\n",
+		   gs->rx_overrun_poll_age_ns);
+	seq_printf(m, "rx_overrun_ddrc_mode_sts 0x%08x\n",
+		   gs->rx_overrun_ddrc_mode_sts);
+	seq_printf(m, "rx_ring_size   %u\n", gs->bp->rx_ring_size);
+	seq_printf(m, "dma_config     0x%08x\n", gem_readl(gs->bp, DMACFG));
+	seq_printf(m, "tx_irq_polling %u\n", READ_ONCE(gs->tx_irq_polling));
+	seq_printf(m, "tx_completions %u\n", comp);
+	seq_printf(m, "fast_tx        %u\n", READ_ONCE(macb_gemslot_fast_tx));
+	seq_printf(m, "rx_steer_queue %u\n", steer);
+	seq_printf(m, "rx_free_slots  %u\n", free);
+	seq_printf(m, "rx_buffer_size %zu\n", gs->bp->rx_buffer_size);
+	seq_printf(m, "mtu            %u\n", gs->bp->dev->mtu);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(gemslot_stats);
