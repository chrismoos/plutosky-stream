+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * GEM slot fast path, user-space ABI.
+ *
+ * /dev/gemslot0 is tied to GEM0. The reserved-memory pool behind it holds two
+ * rings of slot_count slots of slot_size bytes, the transmit ring first. Slot i
+ * of a ring starts at pool_phys + ring_offset + i * slot_size, and the frame
+ * inside a slot starts at byte offset 2 so the IP header and the payload behind
+ * it are 4-byte aligned.
+ */
+#ifndef _UAPI_LINUX_GEMSLOT_H
+#define _UAPI_LINUX_GEMSLOT_H
+
+#include <linux/types.h>
+#include <linux/ioctl.h>
+
+/* Frame offset inside a slot, and the GEM receive buffer offset. */
+#define GEMSLOT_FRAME_OFFSET	2
+
+/* Entries carried by one TX_SUBMIT, TX_COMPLETIONS, RX_POLL or RX_RETURN. */
+#define GEMSLOT_BATCH_MAX	64
+
+struct gemslot_info {
+	__u32 pool_phys;	/* physical base of the pool */
+	__u32 pool_size;
+	__u32 slot_size;
+	__u32 slot_count;	/* per ring */
+	__u32 tx_offset;	/* ring offsets from pool_phys */
+	__u32 rx_offset;
+};
+
+/* len is the frame length in bytes excluding the FCS. */
+struct gemslot_tx_entry {
+	__u16 slot;
+	__u16 len;
+};
+
+struct gemslot_tx_batch {
+	__u32 count;
+	struct gemslot_tx_entry entries[GEMSLOT_BATCH_MAX];
+};
+
+struct gemslot_rx_entry {
+	__u16 slot;
+	__u16 len;
+};
+
+struct gemslot_rx_batch {
+	__u32 count;
+	struct gemslot_rx_entry entries[GEMSLOT_BATCH_MAX];
+};
+
+struct gemslot_steer {
+	__u16 udp_port;
+	__u16 enable;
+};
+
+#define GEMSLOT_EVENT_TX	0x00000001u
+#define GEMSLOT_EVENT_RX	0x00000002u
+
+struct gemslot_wait {
+	__u32 events;		/* GEMSLOT_EVENT_* to wait on */
+	__u32 timeout_ms;	/* 0 polls without blocking */
+	__u32 tx_threshold;
+	__u32 rx_threshold;
+	__u32 tx_pending;	/* filled on return */
+	__u32 rx_pending;	/* filled on return */
+};
+
+#define GEMSLOT_STREAM_RX 0u
+#define GEMSLOT_STREAM_TX 1u
+
+/* CSR register offsets are relative to the bitstream's CSR window. */
+struct gemslot_stream_config {
+	__u32 direction;
+	__u32 instance;
+	__u32 ctrl;
+	__u32 produced;
+	__u32 observed;
+	__u32 released;
+	__u32 irq_threshold;
+	__u32 submit;
+	__u32 consumed;
+	__u32 consumed_count;
+	__u32 tx_irq_threshold;
+	__u32 slot_first;
+	__u32 slot_count;
+	__u32 frame_len;
+	__u32 udp_port;
+	__u32 format;
+};
+
+struct gemslot_stream_status {
+	__u32 direction;
+	__u32 active;
+	__u64 produced;
+	__u64 submitted;
+	__u64 completed;
+	__u64 consumed_ticks;
+	__u64 dropped;
+};
+
+#define GEMSLOT_IOC_MAGIC	'G'
