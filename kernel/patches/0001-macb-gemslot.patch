+int macb_gemslot_submit(struct macb *bp, const struct gemslot_tx_entry *entries,
+			u32 count)
+{
+	struct gemslot_dev *gs = bp->gemslot;
+	u32 accepted;
+
+	if (!gs)
+		return -ENODEV;
+	if (!netif_running(bp->dev))
+		return -ENETDOWN;
+	if (READ_ONCE(macb_gemslot_fast_tx) ||
+	    READ_ONCE(gs->direct[GEMSLOT_STREAM_RX].active))
+		return macb_gemslot_submit_direct(bp, entries, count);
+
+	for (accepted = 0; accepted < count; accepted++) {
+		const struct gemslot_tx_entry *entry = &entries[accepted];
+		const void *frame = (u8 *)gemslot_va(gs, true, entry->slot) +
+				    GEMSLOT_FRAME_OFFSET;
+		struct sk_buff *skb;
+
+		skb = netdev_alloc_skb_ip_align(bp->dev, entry->len);
+		if (!skb)
+			return accepted ? (int)accepted : -ENOMEM;
+
+		memcpy(skb_put(skb, entry->len), frame, entry->len);
+		skb_reset_mac_header(skb);
+		skb->protocol = ((struct ethhdr *)skb->data)->h_proto;
+		dev_queue_xmit(skb);
+		macb_gemslot_tx_done(gs, entry->slot, entry->len);
+	}
+
+	return accepted;
+}
