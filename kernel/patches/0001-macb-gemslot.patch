+static int macb_gemslot_submit_direct(struct macb *bp,
+				     const struct gemslot_tx_entry *entries, u32 count)
+{
+	struct macb_queue *queue = &bp->queues[0];
+	struct gemslot_dev *gs = bp->gemslot;
+	struct macb_dma_desc *desc;
+	struct macb_tx_skb *tx_skb;
+	unsigned int head, entry, space;
+	unsigned long flags;
+	u32 accepted, i, ctrl;
+
+	spin_lock_irqsave(&bp->lock, flags);
+	if (!netif_running(bp->dev) || !netif_carrier_ok(bp->dev)) {
+		spin_unlock_irqrestore(&bp->lock, flags);
+		return -ENETDOWN;
+	}
+
+	space = CIRC_SPACE(queue->tx_head, queue->tx_tail, bp->tx_ring_size);
+	/* Keep descriptors available for SSH and ordinary network traffic. */
+	accepted = min_t(u32, count,
+			 space > GEMSLOT_TX_NETWORK_RESERVE ?
+			 space - GEMSLOT_TX_NETWORK_RESERVE : 0);
+	if (!accepted) {
+		spin_unlock_irqrestore(&bp->lock, flags);
+		return 0;
+	}
+
+	head = queue->tx_head;
+	for (i = 0; i < accepted; i++) {
+		entry = macb_tx_ring_wrap(bp, head + i);
+		tx_skb = &queue->tx_skb[entry];
+		tx_skb->skb = NULL;
+		tx_skb->mapping = 0;
+		tx_skb->mapped_as_page = false;
+		tx_skb->size = entries[i].len;
+		tx_skb->slot = true;
+		tx_skb->slot_index = entries[i].slot;
+	}
+
+	entry = macb_tx_ring_wrap(bp, head + accepted);
+	desc = macb_tx_desc(queue, entry);
+	ctrl = MACB_BIT(TX_USED);
+	if (entry == bp->tx_ring_size - 1)
+		ctrl |= MACB_BIT(TX_WRAP);
+	desc->ctrl = ctrl;
+
+	i = accepted;
+	while (i--) {
+		entry = macb_tx_ring_wrap(bp, head + i);
+		desc = macb_tx_desc(queue, entry);
+		ctrl = (u32)entries[i].len | MACB_BIT(TX_LAST);
+		if (entry == bp->tx_ring_size - 1)
+			ctrl |= MACB_BIT(TX_WRAP);
+		macb_set_addr(bp, desc,
+			      gemslot_phys(gs, true, entries[i].slot) +
+			      GEMSLOT_FRAME_OFFSET);
+		wmb();
+		desc->ctrl = ctrl;
+	}
+
+	queue->tx_head = head + accepted;
+	wmb();
+	macb_writel(bp, NCR, macb_readl(bp, NCR) | MACB_BIT(TSTART));
+	spin_unlock_irqrestore(&bp->lock, flags);
+	return accepted;
+}
